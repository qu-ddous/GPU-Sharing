{
  "name": "gpushare-studio",
  "version": "1.0.0",
  "description": "GPUShare & GPU Stream Studio: Distributed GPU Rendering & AI Offloading Desktop Platform",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:client": "concurrently -k \"vite\" \"electron . --mode=client\"",
    "dev:server": "concurrently -k \"vite\" \"electron . --mode=server\"",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:all": "npm run build && npm run build:electron",
    "start": "electron .",
    "package": "npm run build:all && electron-builder --win --config.productName=\"GPUShare\" --config.win.executableName=\"GPUShare\"",
    "pack": "npm run build:all && electron-builder --win --dir --config.productName=\"GPUShare\" --config.win.executableName=\"GPUShare\"",
    "dist:client": "npm run build:all && electron-builder --win --dir --config.directories.output=\"dist-release/client\" --config.productName=\"GPUShare-Client\" --config.win.executableName=\"GPUShare-Client\"",
    "dist:server": "npm run build:all && electron-builder --win --dir --config.directories.output=\"dist-release/server\" --config.productName=\"GPUShare-Server\" --config.win.executableName=\"GPUShare-Server\"",
    "dist:client:exe": "npm run build:all && electron-builder --win --config.directories.output=\"dist-release/client\" --config.productName=\"GPUShare-Client\" --config.win.executableName=\"GPUShare-Client\"",
    "dist:server:exe": "npm run build:all && electron-builder --win --config.directories.output=\"dist-release/server\" --config.productName=\"GPUShare-Server\" --config.win.executableName=\"GPUShare-Server\"",
    "dist:all": "npm run dist:client && npm run dist:server",
    "server:daemon": "python -m uvicorn server.app.main:app --host 0.0.0.0 --port 8000 --reload"
  },
  "build": {
    "appId": "com.gpushare.studio",
    "productName": "GPUShare",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "executableName": "GPUShare"
    }
  },
  "dependencies": {
    "axios": "^1.7.9",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
